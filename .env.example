# ── MCP 认证（可选，不设置则跳过认证）──
# MCP_API_KEY=sk-your-secret-key

# ── OSS 配置（gpt-vis-ssr 渲染服务必填）──
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PATH_PREFIX=charts

# ── 图片返回形式（可选）──
# false（默认）：公开桶 + 对象路径
# true：返回带签名的临时链接（适合私有读权限的桶）
OSS_SIGNED_URL_ENABLED=false
# 预签名链接有效期，单位秒（仅 OSS_SIGNED_URL_ENABLED=true 时生效）
OSS_SIGNED_URL_EXPIRES=3600