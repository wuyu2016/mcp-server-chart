# ── MCP 认证（可选，不设置则跳过认证）──
# MCP_API_KEY=sk-your-secret-key

# ── OSS 配置（gpt-vis-ssr 渲染服务必填）──
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PATH_PREFIX=charts

# ── 图片返回形式（可选）──
# false（默认）：公开桶 + 对象路径
# true：返回带签名的临时链接（适合私有读权限的桶）
OSS_SIGNED_URL_ENABLED=false
# 预签名链接有效期，单位秒（仅 OSS_SIGNED_URL_ENABLED=true 时生效）
OSS_SIGNED_URL_EXPIRES=3600

# ── 雷达图刻度（gpt-vis-ssr）──
# 调用方没传 align 时是否让各维共用同一刻度（对齐到这批数据的最大值）。
# true / false，不设置则沿用渲染库默认 false。请求体里的 align 优先于本变量。
# RADAR_ALIGN=true
# 雷达图各维统一上限，必须大于 0。不设置则不封顶。
# 请求体或 defaults.json 里的 radar.max 优先于本变量。
# RADAR_MAX=100